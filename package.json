{
	"name": "obsidian-tadabbur",
	"version": "0.2.0",
	"description": "Quran reflection & journaling — a companion to the Falah plugin.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"validate:release": "node scripts/validate-release.mjs",
		"check": "npm run validate:release && npm run lint && npm test && npm run build"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.4"
	}
}
